# Universal MCP Client Configuration
# Copy this file to .env and customize for your deployment

# LLM Configuration
LLM_PROVIDER=ollama
LLM_MODEL=hf.co/unsloth/gemma-3n-E4B-it-GGUF:Q4_K_XL
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_MINUTES=2
LLM_DEFAULT_LOCALE=en

# UI Configuration
UI_LOCALE=en
UI_SUCCESS_PREFIX=✅
UI_ERROR_PREFIX=❌
UI_WARNING_PREFIX=⚠️
UI_INFO_PREFIX=💡
UI_DATA_PREFIX=📊
UI_TOOL_PREFIX=🔧
UI_CODE_PREFIX=💻
UI_FILE_PREFIX=📁
UI_STRUCTURE_PREFIX=🏗️
UI_CHART_PREFIX=📈

# UI Messages (customizable per locale)
UI_MSG_SUCCESS_CONTACT=Successfully contacted %s, but no specific data was returned for: "%s"
UI_MSG_RESPONSE_FROM=Response from %s
UI_MSG_INFO_PROVIDED=Information provided by %s
UI_MSG_TOOLS_ENABLED=Dynamic toolsets enabled for %s
UI_MSG_MCP_CONTEXT=MCP SERVER CONTEXT
UI_MSG_FORMATTING=SPECIFIC FORMATTING INSTRUCTIONS
UI_SEARCH_KEYWORDS=search,find,buscar,encuentra

# MCP Server Environment Variables
# GitHub MCP Server
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here
GITHUB_DYNAMIC_TOOLSETS=1

# Add other MCP server environment variables as needed
# AZURE_API_KEY=your_azure_key
# AWS_ACCESS_KEY_ID=your_aws_key
# OPENAI_API_KEY=your_openai_key